@model IEnumerable<string>
@inject ICitiesService citiesServiceInView
@{
	ViewBag.Title = "Home";
}
<h1>Cities</h1>
@{
	List<string> citiesFromServiceView = citiesServiceInView.GetCities();
}
<ul class="list">
	@* @foreach (var city in Model) *@
	@foreach (var city in citiesFromServiceView)
	{
		<li>@city</li>
	}
</ul>

<div>@ViewBag.InstanceId_CityService_1</div>
<div>@ViewBag.InstanceId_CityService_2</div>
<div>@ViewBag.InstanceId_CityService_3</div>
<div>@citiesServiceInView.ServiceInstanceId</div>
<div class="box">
	@ViewBag.InstanceId_CityService_InScope
</div>