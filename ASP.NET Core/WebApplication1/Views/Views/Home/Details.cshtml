    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Person
@{
    <!DOCTYPE html>
    <html>
        <head>
            <title>Person Details</title>
            <meta charset="utf-8" />
		<link rel="stylesheet" href="~/StyleSheet.css" />
        </head>
        <body>
            <div class="page-content">
			    <h1>Person Details</h1>
                <div class="box w-50">
                    <table class="table">
                        <tbody>
                            <tr>
                                <td>Name</td>
                                <td>@Model.Name</td>
                            </tr>
                            <tr>
                                <td>Gender</td>
                                <td>@Model.Gender</td>
                            </tr>
                            <tr>
                                <td>Date Of Birth</td>
                                <td>@Model.DateOfBirth</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <a href="/home">Back to people</a>
            </div>
        </body>
    </html>
}
