@model PersonUpdateRequest

@{
	ViewBag.Title = "Edit Person";
}

@section scripts {
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js" asp-fallback-test="window.jQuery" asp-fallback-src="~/jquery.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.4/jquery.validate.min.js" asp-fallback-test="window.jQuery.validator" asp-fallback-src="~/jquery.validate.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js" asp-fallback-test="window.jQuery.validator.unobtrusive" asp-fallback-src="~/jquery.validate.unobtrusive.min.js"></script>
}

@* <a href="~/persons/index" class="link-hover">Back to Persons List</a> *@
<a asp-controller="Persons" asp-action="Index" class="link-hover">Back to Persons List</a>
<h2>Edit Person</h2>

@* <div class="w-50"> *@
<div class="center-box">
	@* <form action="~/persons/create" method="post"> *@
	<form asp-controller="Persons" asp-action="Edit" method="post">

		<input type="hidden" asp-for="PersonID" />

		@*PersonName*@
		<div class="form-field flex">
			<div class="w-25">
				@* <label for="PersonName" class="form-label pt">Person Name</label> *@
				<label asp-for="PersonName" class="form-label pt">Person Name</label>
			</div>
			<div class="flex-1">
				@* <input type="text" id="PersonName" name="PersonName" class="form-input" /> *@
				<input asp-for="PersonName" class="form-input" />
				<span asp-validation-for="PersonName" class="text-red"></span>
			</div>
		</div>

		@*Email*@
		<div class="form-field flex">
			<div class="w-25">
				@* <label for="Email" class="form-label">Email</label> *@
				<label asp-for="Email" class="form-label">Email</label>
			</div>
			<div class="flex-1">
				@* <input type="email" id="Email" name="Email" class="form-input" /> *@
				<input asp-for="Email" class="form-input" />
				<span asp-validation-for="Email" class="text-red"></span>
			</div>
		</div>

		@*DateOfBirth*@
		<div class="form-field flex">
			<div class="w-25">
				@* <label for="DateOfBirth" class="form-label">Date of Birth</label> *@
				<label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
			</div>
			<div class="flex-1">
				@*<input type="date" id="DateOfBirth" name="DateOfBirth" class="form-input" />*@
				<input asp-for="DateOfBirth" class="form-input" />
				<span asp-validation-for="DateOfBirth" class="text-red"></span>
			</div>
		</div>

		@*Gender*@
		<div class="form-field flex">
			<div class="w-25">
				@* <label for="Gender" class="form-label">Gender</label> *@
				<label asp-for="Gender" class="form-label">Gender</label>
			</div>
			<div class="flex-1">
				@* <input type="radio" id="Male" name="Gender" value="Male" />
				<label for="Male" class="form-label">Male</label>
				<input type="radio" id="Female" name="Gender" value="Female" class="ml" />
				<label for="Female" class="form-label">Female</label>
				<input type="radio" id="Other" name="Gender" value="Other" class="ml" />
				<label for="Other" class="form-label">Other</label> *@

				@* <input type="radio" asp-for="Gender" value="Male" />
				<label for="Male" class="form-label">Male</label>
				<input type="radio" asp-for="Gender" value="Female" class="ml" />
				<label for="Female" class="form-label">Female</label>
				<input type="radio" asp-for="Gender" value="Other" class="ml" />
				<label for="Other" class="form-label">Other</label> *@

				@{
					var genderOptions = Enum.GetNames(typeof(GenderOptions));
					@foreach (var gender in genderOptions)
					{
						<input type="radio" asp-for="Gender" value="@gender" />
						<label for="@gender">@gender</label>
					}
					<span asp-validation-for="Gender" class="text-red"></span>
				}
				
			</div>
		</div>

		@*Country*@
		<div class="form-field flex">
			<div class="w-25">
				@* <label for="CountryID" class="form-label">Country</label> *@
				<label asp-for="CountryID" class="form-label">Country</label>
			</div>
			<div class="flex-1">
				@* <select id="CountryID" name="CountryID" class="form-input">
					<option value="">-- Select Country --</option>
					@foreach (var country in ViewBag.Countries)
					{
						<option value="@country.CountryID">@country.CountryName</option>
					}
				</select> *@
				@* <select asp-for="CountryID" class="form-input">
					<option value="">-- Select Country --</option>
					@foreach (var country in ViewBag.Countries)
					{
						<option value="@country.CountryID">@country.CountryName</option>
					}
				</select> *@
				<select asp-for="CountryID" asp-items="ViewBag.Countries" class="form-input">
					<option value="">-- Select Country --</option>
				</select>
				<span asp-validation-for="CountryID" class="text-red"></span>
			</div>
		</div>

		@*Address*@
		<div class="form-field flex">
			<div class="w-25">
				@* <label for="Address" class="form-label pt">Address</label> *@
				<label asp-for="Address" class="form-label pt">Address</label>
			</div>
			<div class="flex-1">
				@* <textarea id="Address" name="Address" class="form-input"></textarea> *@
				<textarea asp-for="Address" class="form-input"></textarea>
				<span asp-validation-for="Address" class="text-red"></span>
			</div>
		</div>

		@*ReceiveNewsLetters*@
		<div class="form-field flex">
			<div class="w-25">
			</div>
			<div class="flex-1">
				@* <input type="checkbox" id="ReceiveNewsLetters" name="ReceiveNewsLetters" value="true" />
				<label for="ReceiveNewsLetters">Receive News Letters</label> *@
				<input asp-for="ReceiveNewsLetters" value="true" />
				@* <label for="ReceiveNewsLetters">Receive News Letters</label> *@
				<label asp-for="ReceiveNewsLetters">Receive News Letters</label>
				<span asp-validation-for="ReceiveNewsLetters" class="text-red"></span>
			</div>
		</div>

		@*Submit*@
		<div class="form-field flex">
			<div class="w-25">
			</div>
			<div class="flex-1">
				<button class="button button-green-back">Update</button>

				<div asp-validation-summary="All" class="mt text-red">
				</div>
				@if (ViewBag.ErrorMessage != null)
				{
					<div class="text-red ml">
						<ul>
							@foreach (var error in ViewBag.ErrorMessage)
							{
								<li class="ml">@error</li>
							}
						</ul>
					</div>
				}
			</div>
		</div>
	</form>
</div>

@* <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js" asp-fallback-test="window.jQuery" asp-fallback-src="~/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.4/jquery.validate.min.js" asp-fallback-test="window.jQuery.validator" asp-fallback-src="~/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js" asp-fallback-test="window.jQuery.validator.unobtrusive" asp-fallback-src="~/jquery.validate.unobtrusive.min.js"></script> *@